# Set these in Vercel → Project → Settings → Environment Variables (then redeploy).
# All are optional; the site builds without them.

# Public site URL (enables canonical tags + sitemap.xml). Falls back to site.json "url",
# then to Vercel's production URL.
SITE_URL=

# Lead form endpoint. Formspree: https://formspree.io/f/xxxxxxx
#                     Web3Forms: https://api.web3forms.com/submit  (also set FORM_ACCESS_KEY)
FORM_ENDPOINT=
FORM_ACCESS_KEY=

# Analytics: pick one. Plausible is cookieless (no banner). GA4 shows a consent banner first.
PLAUSIBLE_DOMAIN=
GA4_ID=
